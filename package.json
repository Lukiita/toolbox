{
  "name": "@lukiita/toolbox",
  "version": "1.0.0",
  "description": "Lucas's agent toolbox as a versioned library: skills, agent hooks and the quality ratchet, config-driven.",
  "license": "MIT",
  "type": "module",
  "repository": "github:Lukiita/toolbox",
  "engines": {
    "node": ">=22.18 <23 || >=23.6"
  },
  "bin": {
    "toolbox": "./dist/cli/toolbox.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config/index.mjs",
    "./hooks/*.mjs": "./hooks/*.mjs"
  },
  "files": [
    "dist",
    "hooks",
    "!hooks/*.test.ts",
    "skills",
    "templates",
    "toolbox.config.example.ts"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:check": "node scripts/build-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "quality": "node dist/cli/toolbox.mjs quality",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jscpd": "5.0.14",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "vitest": ">=3",
    "@vitest/coverage-v8": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "@vitest/coverage-v8": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "prettier": "^3.6.0",
    "vitest": "^4.0.0"
  }
}
